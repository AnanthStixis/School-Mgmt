PORT=3000
DATABASE_URL=postgresql://sms:sms_dev_password@localhost:5432/sms?schema=public
# Not used yet (kept for later background jobs).
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:5174
# Signs access tokens and OTP hashes. At least 32 random characters; never reuse across environments.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Local development only: password given to the seeded staff accounts by `pnpm db:seed`.
SEED_PASSWORD=

# Hosted test system only (with NODE_ENV=production): simulated SMS and payments, and a TEST SYSTEM banner.
# TEST_SYSTEM=true
# Production / test system: the web app's build folder, so the API serves the web app too (set in the Docker image).
# WEB_DIST=../web/dist
