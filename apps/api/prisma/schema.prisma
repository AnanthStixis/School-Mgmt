// Foundation schema derived from the POC (Poc/assets/data.js).
// Every tenant-owned row carries tenantId so isolation can be enforced (Postgres RLS can be added later).
// Module tables (fees, attendance, marks, tickets…) are added per module in phase 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  teacher
  accounts
  parent
  student
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  trust         String?
  plan          String   @default("Growth")
  city          String?
  /// Receipt numbers are <prefix>/<academic year>/<nnnn>, one series for the whole school per year.
  receiptPrefix String   @default("RCPT")
  createdAt     DateTime @default(now())

  branches      Branch[]
  users         User[]
  academicYears AcademicYear[]
  auditLogs     AuditLog[]
}

/// An institution under the trust: School, Pre-School, PU College.
model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  /// BNMPS – also used in receipt numbers
  code      String
  name      String
  board     String
  color     String   @default("#e8650a")
  address   String?
  phone     String?
  email     String?
  city      String?
  since     Int?
  active    Boolean  @default(true)
  /// Working days, school timings, terms per year, attendance threshold… (see BranchSettings in @sms/shared)
  settings  Json?
  /// Modules switched on for this branch, e.g. { "library": false }. Missing keys mean on.
  modules   Json?
  createdAt DateTime @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  users     User[]
  classes   SchoolClass[]
  students  Student[]
  staff     Staff[]
  subjects  Subject[]
  enquiries Enquiry[]
  feeTypes  FeeType[]
  feeBands  FeeBand[]
  receipts  FeeReceipt[]

  @@unique([tenantId, code])
}

/// A login. tenantId is null only for the Stixis platform admin; branchId null = all branches.
model User {
  id           String    @id @default(cuid())
  tenantId     String?
  branchId     String?
  role         Role
  name         String
  title        String    @default("")
  /// Optional: parents often have none. Needed for e-mail + password sign-in.
  email        String?   @unique
  /// E.164 (+91…). Used for OTP sign-in (parents, students, and staff without a password).
  phone        String?   @unique
  /// Student login ID (their admission number, upper-case). Students have no phone of their own,
  /// so they sign in with this and a password their parent or the school sets.
  username     String?   @unique
  /// Staff and students sign in with a password; parents have none (OTP only).
  passwordHash String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  tenant        Tenant?           @relation(fields: [tenantId], references: [id])
  branch        Branch?           @relation(fields: [branchId], references: [id])
  staff         Staff?
  student       Student?          @relation("StudentLogin")
  children      StudentGuardian[]
  refreshTokens RefreshToken[]
}

/// Long-lived session token. Only a SHA-256 hash is stored; rotated on every refresh.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time sign-in code sent by SMS. Only a hash of the code is stored.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model AcademicYear {
  id       String   @id @default(cuid())
  tenantId String
  /// "2026-27"
  label    String
  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date
  current  Boolean  @default(false)
  /// archived years are read-only
  locked   Boolean  @default(false)

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  classes   SchoolClass[]
  enquiries Enquiry[]
  feeTypes  FeeType[]
  receipts  FeeReceipt[]

  @@unique([tenantId, label])
}

model SchoolClass {
  id             String   @id @default(cuid())
  branchId       String
  academicYearId String
  /// -2 Nursery, -1 LKG, 0 UKG, 1-12
  grade          Int
  section        String
  /// "8-A", "PUC I Science"
  name           String
  room           String?
  classTeacherId String?
  createdAt      DateTime @default(now())

  branch       Branch               @relation(fields: [branchId], references: [id])
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id])
  classTeacher Staff?               @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students     Student[]
  attendance   AttendanceRecord[]
  registers    AttendanceRegister[]

  @@unique([branchId, academicYearId, name])
}

model Staff {
  id            String    @id @default(cuid())
  branchId      String
  userId        String?   @unique
  name          String
  /// Teacher, Accounts Officer, Front Office…
  role          String
  subject       String?
  email         String?
  phone         String?
  qualification String?
  /// Active, Inactive
  status        String    @default("Active")
  joinedOn      DateTime? @db.Date
  createdAt     DateTime  @default(now())

  branch       Branch        @relation(fields: [branchId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  classTeacher SchoolClass[] @relation("ClassTeacher")
}

model Student {
  id            String    @id @default(cuid())
  branchId      String
  classId       String?
  userId        String?   @unique
  admissionNo   String
  name          String
  /// M, F, O
  gender        String?
  dob           DateTime? @db.Date
  rollNo        Int?
  bloodGroup    String?
  house         String?
  address       String?
  admittedOn    DateTime? @db.Date
  /// Active, Alumni, Left, Temporary
  status        String    @default("Active")
  // ---- fee profile: decides which fee rate applies ----
  /// Re-admission, New Admission, UKG to ICSE, State to ICSE
  admissionType String    @default("Re-admission")
  /// Right to Education quota student (fee rules differ)
  rte           Boolean   @default(false)
  /// Child of a staff member (reported as a group)
  staffKid      Boolean   @default(false)
  /// Transport distance slab, e.g. "1 to 2 km"; null = no school transport
  transportSlab String?
  /// Pickup & Drop, Pickup, Drop
  pickupMode    String?
  createdAt     DateTime  @default(now())

  branch         Branch             @relation(fields: [branchId], references: [id])
  class          SchoolClass?       @relation(fields: [classId], references: [id])
  user           User?              @relation("StudentLogin", fields: [userId], references: [id])
  guardians      StudentGuardian[]
  attendance     AttendanceRecord[]
  enquiry        Enquiry?
  feeAssignments FeeAssignment[]
  feeReceipts    FeeReceipt[]
  feeCorrections FeeCorrection[]
  feeRefunds     FeeRefund[]
  payments       PaymentAttempt[]

  @@unique([branchId, admissionNo])
}

model StudentGuardian {
  studentId String
  userId    String
  /// Father, Mother, Guardian
  relation  String  @default("Parent")
  /// Receives alerts and fee reminders first.
  primary   Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@id([studentId, userId])
}

/// Append-only audit trail (fee corrections, receipt cancellation, RBAC changes…).
/// tenantId is null for platform-level events (Stixis admin).
model AuditLog {
  id       String   @id @default(cuid())
  tenantId String?
  actorId  String?
  action   String
  entity   String
  entityId String?
  data     Json?
  ip       String?
  at       DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entity, entityId])
}

/// Subject master per branch (POC: Academic Setup → Subject master).
model Subject {
  id       String  @id @default(cuid())
  branchId String
  name     String
  code     String
  /// Core, Language, Elective, Co-scholastic
  type     String  @default("Core")
  active   Boolean @default(true)
  /// Shown on the report card
  onReport Boolean @default(true)

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, code])
}

/// Admissions CRM: one prospective student, from first enquiry to enrolment.
model Enquiry {
  id              String    @id @default(cuid())
  tenantId        String
  branchId        String
  /// The year the child is applying for (often next year)
  academicYearId  String
  childName       String
  gender          String?
  dob             DateTime? @db.Date
  /// Grade applied for: -2 Nursery … 12
  grade           Int
  parentName      String
  parentPhone     String
  altPhone        String?
  parentEmail     String?
  city            String?
  address         String?
  previousSchool  String?
  previousBoard   String?
  siblingInSchool Boolean   @default(false)
  /// Website, Walk-in, Referral, Facebook Ad, Google Ad, Other
  source          String    @default("Walk-in")
  /// Enquiry, Applied, Test/Interview, Admitted, Enrolled, Dropped
  stage           String    @default("Enquiry")
  dropReason      String?
  nextFollowUp    DateTime? @db.Date
  /// Set when the child is enrolled
  studentId       String?   @unique
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  branch       Branch            @relation(fields: [branchId], references: [id])
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id])
  student      Student?          @relation(fields: [studentId], references: [id])
  activity     EnquiryActivity[]

  @@index([branchId, stage])
  @@index([parentPhone])
}

/// Timeline of an enquiry: stage changes and staff notes.
model EnquiryActivity {
  id        String   @id @default(cuid())
  enquiryId String
  /// stage | note | created | enrolled
  kind      String
  text      String
  byId      String?
  byName    String?
  at        DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, at])
}

/// One student's mark for one school day. P = present, A = absent, L = leave.
model AttendanceRecord {
  id         String   @id @default(cuid())
  studentId  String
  classId    String
  date       DateTime @db.Date
  status     String
  markedById String?
  markedAt   DateTime @default(now())

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([studentId, date])
  @@index([classId, date])
}

/// A class's register for a day has been submitted (and by whom).
model AttendanceRegister {
  id            String   @id @default(cuid())
  classId       String
  date          DateTime @db.Date
  submittedById String?
  submittedBy   String?
  submittedAt   DateTime @default(now())

  class SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([classId, date])
}

/// Outgoing messages (SMS now; WhatsApp/app push later). dedupeKey stops repeats,
/// e.g. one absence alert per guardian per student per day.
/// One message to one user on one channel: sms, email or inapp (the feed behind the bell / Notices tab).
/// Recorded before sending under a dedupe key, so nothing is sent twice.
model Notification {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  /// sms, email, inapp
  channel        String    @default("sms")
  /// receipt, absence, fee_reminder, announcement, otp…
  template       String
  title          String?
  text           String
  /// Where the in-app notice leads, e.g. /receipts/<id>
  link           String?
  /// queued, sent, failed (in-app notices are "sent" when created)
  status         String    @default("queued")
  error          String?
  dedupeKey      String    @unique
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  readAt         DateTime?
  announcementId String?

  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, channel, createdAt])
}

/// A circular from the school: in-app for everyone in the audience, optionally by SMS and e-mail too.
model Announcement {
  id            String    @id @default(cuid())
  tenantId      String
  /// null = every branch of the school
  branchId      String?
  title         String
  body          String
  /// PARENTS, STAFF, EVERYONE or CLASSES (parents of the listed classes)
  audience      String
  classIds      Json?
  /// Normal, Important, Urgent
  priority      String    @default("Normal")
  pinned        Boolean   @default(false)
  sms           Boolean   @default(false)
  email         Boolean   @default(false)
  recipients    Int       @default(0)
  smsSent       Int       @default(0)
  emailSent     Int       @default(0)
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())
  withdrawnAt   DateTime?

  notifications Notification[]

  @@index([tenantId, createdAt])
}

/// Class band used to price the school fee, e.g. "G5–G7" = grades 5 to 7. Per branch.
model FeeBand {
  id        String @id @default(cuid())
  branchId  String
  name      String
  fromGrade Int
  toGrade   Int

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, name])
}

/// A fee "blueprint" for one branch and academic year: School Fees 26-27, Transportation Fees 26-27…
model FeeType {
  id             String   @id @default(cuid())
  branchId       String
  academicYearId String
  /// SCHOOL (by band × admission type), TRANSPORT (by slab × pickup), APPLICATION (flat), CUSTOM
  kind           String
  name           String
  /// [{ name, percent }] — how each installment splits into receipt components
  components     Json?
  /// false while amounts are placeholders awaiting the school's fee chart
  ratesConfirmed Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  branch       Branch               @relation(fields: [branchId], references: [id])
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id])
  installments FeeInstallmentPlan[]
  rates        FeeRate[]
  assignments  FeeAssignment[]

  @@unique([branchId, academicYearId, name])
}

/// Installment schedule of a fee type. The total is split equally (last one takes the rounding).
model FeeInstallmentPlan {
  id        String   @id @default(cuid())
  feeTypeId String
  seq       Int
  label     String
  dueDate   DateTime @db.Date

  feeType FeeType @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)

  @@unique([feeTypeId, seq])
}

/// One price in a fee type's chart. key = "<band>|<admission type>" (SCHOOL),
/// "<slab>|<pickup mode>" (TRANSPORT) or "*" (APPLICATION).
model FeeRate {
  id        String @id @default(cuid())
  feeTypeId String
  key       String
  /// Annual amount in whole rupees
  amount    Int

  feeType FeeType @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)

  @@unique([feeTypeId, key])
}

/// A fee type assigned to one student (the POC's feeAssign). Its installments are FeeInvoice rows.
/// Lifecycle: ASSIGNED → CONFIRMED → PUBLISHED (parents can see it); onlineEnabled once published.
model FeeAssignment {
  id            String    @id @default(cuid())
  studentId     String
  feeTypeId     String
  /// What the price was based on, e.g. "G5–G7 · Re-admission" or "1 to 2 km · Pickup & Drop"
  category      String
  /// Annual amount at the time of assignment (later chart changes don't alter it)
  gross         Int
  status        String    @default("ASSIGNED")
  onlineEnabled Boolean   @default(false)
  createdById   String?
  createdAt     DateTime  @default(now())
  confirmedAt   DateTime?
  publishedAt   DateTime?

  student     Student         @relation(fields: [studentId], references: [id])
  feeType     FeeType         @relation(fields: [feeTypeId], references: [id])
  invoices    FeeInvoice[]
  corrections FeeCorrection[]

  @@unique([studentId, feeTypeId])
  @@index([feeTypeId, status])
}

/// One installment a student owes. Amounts in whole rupees.
/// Late fee accrues per day on an unpaid balance from max(dueDate, fineFrom) until it is paid or waived.
model FeeInvoice {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  seq          Int
  label        String
  dueDate      DateTime  @db.Date
  gross        Int
  concession   Int       @default(0)
  adjustment   Int       @default(0)
  paid         Int       @default(0)
  finePaid     Int       @default(0)
  fineWaived   Int       @default(0)
  /// Money paid back against receipts (does not change the balance; collected net = paid − refunded)
  refunded     Int       @default(0)
  /// Set when the late fee so far is settled (paid or waived); it restarts from this day.
  fineFrom     DateTime? @db.Date

  assignment FeeAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  lines      FeeReceiptLine[]

  @@unique([assignmentId, seq])
  @@index([studentId])
}

/// A payment receipt (counter or, later, online). Numbers never repeat; a cancelled receipt stays for audit.
model FeeReceipt {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String
  studentId      String
  academicYearId String
  /// e.g. BNMPS/2026-27/0042
  no             String
  date           DateTime  @db.Date
  /// Cash, Cheque, DD, Net Banking, UPI, Credit Card, Debit Card
  mode           String
  /// Counter or Online
  source         String    @default("Counter")
  /// SUCCESS or CANCELLED
  status         String    @default("SUCCESS")
  feeTotal       Int
  fineTotal      Int
  total          Int
  bank           String?
  instrumentNo   String?
  instrumentDate DateTime? @db.Date
  /// UTR / transaction reference for electronic modes
  reference      String?
  remarks        String?
  /// NA, PENDING (cheque / net banking until the bank confirms), DONE, FAILED
  recon          String    @default("NA")
  createdById    String
  createdByName  String
  createdAt      DateTime  @default(now())
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?

  student      Student          @relation(fields: [studentId], references: [id])
  branch       Branch           @relation(fields: [branchId], references: [id])
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id])
  lines        FeeReceiptLine[]
  refunds      FeeRefund[]

  @@unique([tenantId, no])
  @@index([branchId, date])
  @@index([studentId])
}

model FeeReceiptLine {
  id           String    @id @default(cuid())
  receiptId    String
  invoiceId    String
  /// "School Fee 2026-27 · Installment 3"
  label        String
  fee          Int
  fine         Int       @default(0)
  fineWaived   Int       @default(0)
  /// The invoice's fineFrom before this receipt, restored if the receipt is cancelled
  prevFineFrom DateTime? @db.Date

  receipt FeeReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

/// Last receipt number used per school and academic year.
model ReceiptSequence {
  tenantId  String
  yearLabel String
  last      Int    @default(0)

  @@id([tenantId, yearLabel])
}

/// A correction to a student's fees, with who and why: CONCESSION (replaces the previous one on the
/// assignment), ADJUSTMENT (write-off of the unpaid part, e.g. a student leaving) or FINE_WAIVER.
model FeeCorrection {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String
  studentId     String
  assignmentId  String
  kind          String
  /// Total of this correction in rupees (for a concession: the new total concession on the assignment)
  amount        Int
  /// [{ invoiceId, label, amount }] plus how it was spread, e.g. { method: "Equal", percent: 10 }
  detail        Json
  remarks       String
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  student    Student       @relation(fields: [studentId], references: [id])
  assignment FeeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, createdAt])
  @@index([assignmentId])
}

/// Money paid back against a receipt (usually by cheque when a student leaves). One receipt can have several.
model FeeRefund {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String
  studentId     String
  receiptId     String
  amount        Int
  date          DateTime @db.Date
  mode          String
  bank          String?
  instrumentNo  String?
  remarks       String
  /// [{ invoiceId, amount }]
  allocation    Json
  status        String   @default("Completed")
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  student Student    @relation(fields: [studentId], references: [id])
  receipt FeeReceipt @relation(fields: [receiptId], references: [id])

  @@index([tenantId, date])
  @@index([receiptId])
}

/// One online payment attempt. Every attempt is a row first (INITIATED); the gateway's answer decides the rest:
/// SUCCESS (a receipt is issued), FAILED (declined / failed), PENDING (bank still deciding). Retries are new attempts.
model PaymentAttempt {
  id            String    @id @default(cuid())
  tenantId      String
  branchId      String
  studentId     String
  /// Our order id, sent to the gateway
  orderId       String    @unique
  gateway       String
  amount        Int
  /// [{ invoiceId, label, fee, fine }] as priced when the parent started paying
  lines         Json
  status        String    @default("INITIATED")
  /// Gateway response code (0 success, 1072 declined, 1000 failed, 1006 waiting in the existing system)
  code          Int?
  message       String?
  mode          String?
  gatewayTxnId  String?
  receiptId     String?   @unique
  /// Paid online but no longer owed (e.g. paid at the counter meanwhile): to be refunded by Accounts
  excess        Int       @default(0)
  initiatedById String
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  student Student @relation(fields: [studentId], references: [id])

  @@index([tenantId, createdAt])
  @@index([studentId])
}
